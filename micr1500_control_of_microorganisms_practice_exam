    <script>
        // 30 Complete Study Guide Questions
        const questions = [
            {
                id: 1, section: "part1", type: "mc",
                text: "A chemical used on living tissue to destroy pathogens is called a(n):",
                options: [
                    { key: "A", text: "Disinfectant" },
                    { key: "B", text: "Antiseptic" },
                    { key: "C", text: "Sterilant" },
                    { key: "D", text: "Sanitizer" }
                ],
                correct: "B",
                why: "Antiseptics go on living tissue; disinfectants go on inanimate objects."
            },
            {
                id: 2, section: "part1", type: "mc",
                text: "Conditions that are free of contaminating microbes are described as:",
                options: [
                    { key: "A", text: "Septic" },
                    { key: "B", text: "Sanitized" },
                    { key: "C", text: "Aseptic" },
                    { key: "D", text: "Degermed" }
                ],
                correct: "C",
                why: "Aseptic means free of contaminating microbes; septic means already contaminated."
            },
            {
                id: 3, section: "part1", type: "sata",
                text: "Which statements about sterilization are true? (Select all that apply.)",
                options: [
                    { key: "A", text: "It destroys or removes all forms of life" },
                    { key: "B", text: "There is an in-between 'partly sterile' state" },
                    { key: "C", text: "Prions are easily sterilized" },
                    { key: "D", text: "It includes destroying bacterial spores" },
                    { key: "E", text: "Bacterial spores are the most resistant microbe it kills" }
                ],
                correct: ["A", "D", "E"],
                why: "Sterilization is all-or-nothing (no in-between), includes spores, and cannot sterilize prions."
            },
            {
                id: 4, section: "part1", type: "mc",
                text: "A bacteriostatic agent:",
                options: [
                    { key: "A", text: "Slows or stops bacterial growth without killing" },
                    { key: "B", text: "Kills all bacteria on contact" },
                    { key: "C", text: "Removes microbes from a surface" },
                    { key: "D", text: "Destroys all bacterial spores" }
                ],
                correct: "A",
                why: "'-static' means slow growth, so growth can come back once the agent is removed."
            },
            {
                id: 5, section: "part1", type: "mc",
                text: "Which microbe is the most resistant to antimicrobial agents?",
                options: [
                    { key: "A", text: "Bacterial endospores" },
                    { key: "B", text: "Mycobacteria" },
                    { key: "C", text: "Fungal spores" },
                    { key: "D", text: "Prions" }
                ],
                correct: "D",
                why: "Prions sit at the hardest, most resistant end of the susceptibility ladder."
            },
            {
                id: 6, section: "part2", type: "mc",
                text: "Gram-negative bacteria are more resistant to chemicals than Gram-positive bacteria. The structure noted in the lecture is the:",
                options: [
                    { key: "A", text: "Waxy cell wall" },
                    { key: "B", text: "Periplasmic space" },
                    { key: "C", text: "Viral envelope" },
                    { key: "D", text: "Dormant cyst wall" }
                ],
                correct: "B",
                why: "The periplasmic space is the specific structural feature linked to Gram-negative chemical resistance."
            },
            {
                id: 7, section: "part2", type: "sata",
                text: "Which factors affect how well an antimicrobial measure works? (Select all that apply.)",
                options: [
                    { key: "A", text: "Intensity or concentration of the measure" },
                    { key: "B", text: "Whether the measure is physical or chemotherapeutic" },
                    { key: "C", text: "Time of exposure" },
                    { key: "D", text: "Environmental factors such as organic matter" },
                    { key: "E", text: "The microbial population" }
                ],
                correct: ["A", "C", "D", "E"],
                why: "The five factors are population, environment (organic matter), time, intensity, and microbial characteristics."
            },
            {
                id: 8, section: "part2", type: "mc",
                text: "If 1,000,000 bacteria die at a constant 90% per minute, how many survive after 3 minutes?",
                options: [
                    { key: "A", text: "1,000" },
                    { key: "B", text: "10,000" },
                    { key: "C", text: "100" },
                    { key: "D", text: "100,000" }
                ],
                correct: "A",
                why: "100,000 survive after 1 min, 10,000 after 2 min, and 1,000 after 3 min."
            },
            {
                id: 9, section: "part2", type: "mc",
                text: "Ranking microbes from most to least susceptible, which one is third?",
                options: [
                    { key: "A", text: "Fungi" },
                    { key: "B", text: "Gram-negative bacteria" },
                    { key: "C", text: "Nonenveloped viruses" },
                    { key: "D", text: "Mycobacteria" }
                ],
                correct: "C",
                why: "The order starts with 1: Enveloped viruses, 2: Gram+, 3: Nonenveloped viruses."
            },
            {
                id: 10, section: "part2", type: "mc",
                text: "Thermal death time is the:",
                options: [
                    { key: "A", text: "Temperature needed to kill a population in a given time" },
                    { key: "B", text: "Time needed for bacteria to double" },
                    { key: "C", text: "Lowest temperature at which microbes grow" },
                    { key: "D", text: "Time needed to kill a population of microbes at a given temperature" }
                ],
                correct: "D",
                why: "TDT = time at a set temperature; TDP is temperature for a set time."
            },
            {
                id: 11, section: "part3", type: "mc",
                text: "Which condition sterilizes in an autoclave?",
                options: [
                    { key: "A", text: "100°C for 10 minutes" },
                    { key: "B", text: "121°C for 15 minutes" },
                    { key: "C", text: "160°C for 2 hours" },
                    { key: "D", text: "71.6°C for 15 seconds" }
                ],
                correct: "B",
                why: "Autoclaving uses pressurized steam at 121°C for 15 minutes at 15 psi."
            },
            {
                id: 12, section: "part3", type: "sata",
                text: "Heat kills microbes by: (Select all that apply.)",
                options: [
                    { key: "A", text: "Inhibiting protein synthesis" },
                    { key: "B", text: "Destroying membranes" },
                    { key: "C", text: "Denaturing and oxidizing proteins" },
                    { key: "D", text: "Dehydration" },
                    { key: "E", text: "Breaking down cell walls only" }
                ],
                correct: ["B", "C", "D"],
                why: "Heat destroys membranes, denatures proteins, and dehydrates."
            },
            {
                id: 13, section: "part3", type: "mc",
                text: "Which pasteurization method is the most common?",
                options: [
                    { key: "A", text: "71.6°C for 15 seconds" },
                    { key: "B", text: "62.9°C for 30 minutes" },
                    { key: "C", text: "82°C for 3 seconds" },
                    { key: "D", text: "100°C for 10 minutes" }
                ],
                correct: "A",
                why: "Flash pasteurization (71.6°C for 15 s) is the most common and tested type."
            },
            {
                id: 14, section: "part3", type: "sata",
                text: "Which statements about boiling water are true? (Select all that apply.)",
                options: [
                    { key: "A", text: "Bacterial spores are killed in 10 minutes" },
                    { key: "B", text: "It is not effective at sterilizing" },
