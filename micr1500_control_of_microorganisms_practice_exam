        // State variables
        let currentFilter = 'all';
        let filteredQuestions = [...questions];
        let currentIndex = 0;
        let userSelections = {}; // Temporary selection before submit { qId: string or [strings] }
        let submittedAnswers = {}; // Finalized submissions { qId: { selected: ..., isCorrect: ... } }
        let isDarkMode = true;

        // DOM elements
        const bodyRoot = document.getElementById('body-root');
        const themeToggleBtn = document.getElementById('theme-toggle-btn');
        const themeIcon = document.getElementById('theme-icon');
        const themeText = document.getElementById('theme-text');
        const welcomeView = document.getElementById('welcome-view');
        const examView = document.getElementById('exam-view');
        const resultsView = document.getElementById('results-view');
        const sidebarContainer = document.getElementById('sidebar-container');
        const gradeDisplay = document.getElementById('grade-display');
        const questionBadge = document.getElementById('question-badge');
        const questionTypeBadge = document.getElementById('question-type-badge');
        const selectAllNote = document.getElementById('select-all-note');
        const questionTitle = document.getElementById('question-title');
        const optionsContainer = document.getElementById('options-container');
        const feedbackBox = document.getElementById('feedback-box');
        const feedbackHeader = document.getElementById('feedback-header');
        const feedbackRationale = document.getElementById('feedback-rationale');
        const submitAnsBtn = document.getElementById('submit-ans-btn');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const nextBtnText = document.getElementById('next-btn-text');
        const navigatorGrid = document.getElementById('navigator-grid');
        const sidebarAnsweredCount = document.getElementById('sidebar-answered-count');
        const finishExamSection = document.getElementById('finish-exam-section');

        // Theme Toggle Functionality
        function toggleTheme() {
            isDarkMode = !isDarkMode;
            if (isDarkMode) {
                bodyRoot.className = 'bg-slate-900 text-slate-100 h-full flex flex-col antialiased transition-colors duration-300 dark';
                themeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>';
                themeIcon.className = 'w-4 h-4 text-amber-400';
                themeText.textContent = 'Light Mode';
            } else {
                bodyRoot.className = 'bg-slate-50 text-slate-900 h-full flex flex-col antialiased transition-colors duration-300';
                themeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>';
                themeIcon.className = 'w-4 h-4 text-indigo-600';
                themeText.textContent = 'Dark Mode';
            }
        }

        // Filter functionality
        function setFilter(filterKey) {
            currentFilter = filterKey;
            
            // Update button styles
            document.querySelectorAll('.filter-pill').forEach(btn => {
                btn.className = isDarkMode 
                    ? 'filter-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700'
                    : 'filter-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200';
            });
            event.target.className = 'filter-pill active-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all bg-emerald-600 text-white shadow-md shadow-emerald-600/20';

            if (filterKey === 'all') {
                filteredQuestions = [...questions];
            } else {
                filteredQuestions = questions.filter(q => q.section === filterKey);
            }

            currentIndex = 0;
            if (examView.classList.contains('hidden') === false) {
                loadQuestion(currentIndex);
            }
        }

        function startExam() {
            welcomeView.classList.add('hidden');
            examView.classList.remove('hidden');
            sidebarContainer.classList.remove('hidden');
            buildNavigator();
            loadQuestion(0);
            updateLiveGrade();
        }

        function buildNavigator() {
            navigatorGrid.innerHTML = '';
            filteredQuestions.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.id = `nav-btn-${idx}`;
                btn.className = 'w-10 h-10 rounded-xl font-semibold text-xs transition-all flex items-center justify-center border';
                btn.textContent = q.id;
                btn.onclick = () => goToQuestion(idx);
                navigatorGrid.appendChild(btn);
            });
            updateNavigatorUI();
        }

        function updateNavigatorUI() {
            filteredQuestions.forEach((q, idx) => {
                const btn = document.getElementById(`nav-btn-${idx}`);
                if (!btn) return;
                
                const isSub = submittedAnswers[q.id] !== undefined;
                const isCurrent = idx === currentIndex;

                let classStr = 'w-10 h-10 rounded-xl font-semibold text-xs transition-all flex items-center justify-center border relative';
                
                if (isCurrent) {
                    classStr += isDarkMode ? ' ring-2 ring-emerald-500 ring-offset-2 ring-offset-slate-800' : ' ring-2 ring-emerald-500 ring-offset-2 ring-offset-white';
                }

                if (isSub) {
                    if (submittedAnswers[q.id].isCorrect) {
                        classStr += ' bg-emerald-500/20 border-emerald-500 text-emerald-400';
                    } else {
                        classStr += ' bg-rose-500/20 border-rose-500 text-rose-400';
                    }
                } else {
                    classStr += isDarkMode ? ' bg-slate-700/60 border-slate-600 text-slate-300 hover:bg-slate-700' : ' bg-slate-100 border-slate-200 text-slate-700 hover:bg-slate-200';
                }

                btn.className = classStr;
            });

            const submittedCount = Object.keys(submittedAnswers).length;
            sidebarAnsweredCount.textContent = `${submittedCount} of 30 Submitted`;

            if (submittedCount > 0) {
                finishExamSection.classList.remove('hidden');
            } else {
                finishExamSection.classList.add('hidden');
            }
        }

        function loadQuestion(index) {
            currentIndex = index;
            const q = filteredQuestions[index];

            questionBadge.textContent = `Question ${index + 1} of ${filteredQuestions.length} (Q${q.id})`;

            if (q.type === 'sata') {
                questionTypeBadge.textContent = 'Select All That Apply';
                questionTypeBadge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30';
                selectAllNote.classList.remove('hidden');
            } else {
                questionTypeBadge.textContent = 'Multiple Choice';
                questionTypeBadge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30';
                selectAllNote.classList.add('hidden');
            }

            questionTitle.textContent = q.text;

            const isSub = submittedAnswers[q.id] !== undefined;

            // Render Options
            optionsContainer.innerHTML = '';
            q.options.forEach(opt => {
                const label = document.createElement('label');
                
                let baseStyle = isDarkMode 
                    ? 'flex items-start p-4 rounded-xl border border-slate-700 bg-slate-900/50 cursor-pointer transition-all gap-3'
                    : 'flex items-start p-4 rounded-xl border border-slate-200 bg-white cursor-pointer transition-all gap-3';

                if (isSub) {
                    label.className = baseStyle + ' opacity-90 cursor-default';
                } else {
                    label.className = baseStyle + (isDarkMode ? ' hover:bg-slate-700/50' : ' hover:bg-slate-50');
                }

                // Selection check
                let isSelected = false;
                if (isSub) {
                    const subSel = submittedAnswers[q.id].selected;
                    isSelected = q.type === 'sata' ? subSel.includes(opt.key) : subSel === opt.key;
                } else {
                    const tempSel = userSelections[q.id];
                    isSelected = q.type === 'sata' ? (tempSel && tempSel.includes(opt.key)) : (tempSel === opt.key);
                }

                // Visual coloring if submitted
                if (isSub) {
                    const isCorrectOpt = q.type === 'sata' ? q.correct.includes(opt.key) : q.correct === opt.key;
                    if (isCorrectOpt) {
                        label.className = 'flex items-start p-4 rounded-xl border border-emerald-500 bg-emerald-500/10 cursor-default gap-3';
                    } else if (isSelected && !isCorrectOpt) {
                        label.className = 'flex items-start p-4 rounded-xl border border-rose-500 bg-rose-500/10 cursor-default gap-3';
                    }
                } else if (isSelected) {
                    label.className = isDarkMode 
                        ? 'flex items-start p-4 rounded-xl border border-emerald-500/60 bg-emerald-500/10 cursor-pointer transition-all gap-3 shadow-sm'
                        : 'flex items-start p-4 rounded-xl border border-emerald-400 bg-emerald-50 cursor-pointer transition-all gap-3 shadow-sm';
                }

                let input;
                if (q.type === 'sata') {
                    input = document.createElement('input');
                    input.type = 'checkbox';
                    input.name = `q-${q.id}`;
                    input.value = opt.key;
                    input.checked = isSelected;
                    input.disabled = isSub;
                    input.className = 'mt-1 h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-slate-600 rounded';
                    input.onchange = () => handleSataInput(q.id, opt.key, input.checked);
                } else {
                    input = document.createElement('input');
                    input.type = 'radio';
                    input.name = `q-${q.id}`;
                    input.value = opt.key;
                    input.checked = isSelected;
                    input.disabled = isSub;
                    input.className = 'mt-1 h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-slate-600';
                    input.onchange = () => handleMcInput(q.id, opt.key);
                }

                const spanKey = document.createElement('span');
                spanKey.className = 'font-bold text-emerald-400 min-w-[20px]';
                spanKey.textContent = `${opt.key}.`;

                const spanText = document.createElement('span');
                spanText.className = isDarkMode ? 'text-slate-200 text-sm sm:text-base flex-1' : 'text-slate-800 text-sm sm:text-base flex-1';
                spanText.textContent = opt.text;

                label.appendChild(input);
                label.appendChild(spanKey);
                label.appendChild(spanText);
                optionsContainer.appendChild(label);
            });

            // Feedback box
            if (isSub) {
                showFeedbackUI(q, submittedAnswers[q.id].isCorrect);
                submitAnsBtn.disabled = true;
                submitAnsBtn.textContent = 'Submitted';
                submitAnsBtn.className = 'flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-slate-700 text-slate-400 font-medium text-sm border border-slate-600 cursor-not-allowed';
            } else {
                feedbackBox.classList.add('hidden');
                submitAnsBtn.disabled = false;
                submitAnsBtn.textContent = 'Submit Answer';
                submitAnsBtn.className = 'flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center space-x-1.5';
            }

            prevBtn.disabled = index === 0;
            if (index === filteredQuestions.length - 1) {
                nextBtnText.textContent = 'Review Score';
            } else {
                nextBtnText.textContent = 'Next';
            }

            updateNavigatorUI();
        }

        function handleMcInput(qid, key) {
            userSelections[qid] = key;
            loadQuestion(currentIndex);
        }

        function handleSataInput(qid, key, checked) {
            if (!userSelections[qid]) {
                userSelections[qid] = [];
            }
            if (checked) {
                if (!userSelections[qid].includes(key)) userSelections[qid].push(key);
            } else {
                userSelections[qid] = userSelections[qid].filter(k => k !== key);
            }
            loadQuestion(currentIndex);
        }

        function submitCurrentAnswer() {
            const q = filteredQuestions[currentIndex];
            const sel = userSelections[q.id];

            if (!sel || (Array.isArray(sel) && sel.length === 0)) {
                showAlert("Please select an answer option before submitting.");
                return;
            }

            let isCorrect = false;
            if (q.type === 'sata') {
                const sortedSel = [...sel].sort();
                const sortedCor = [...q.correct].sort();
                isCorrect = JSON.stringify(sortedSel) === JSON.stringify(sortedCor);
            } else {
                isCorrect = sel === q.correct;
            }

            submittedAnswers[q.id] = {
                selected: sel,
                isCorrect: isCorrect
            };

            loadQuestion(currentIndex);
            updateLiveGrade();
        }

        function showFeedbackUI(q, isCorrect) {
            feedbackBox.classList.remove('hidden');
            if (isCorrect) {
                feedbackBox.className = isDarkMode 
                    ? 'mt-6 p-5 rounded-xl border bg-emerald-950/40 border-emerald-500/50 text-emerald-200 text-sm'
                    : 'mt-6 p-5 rounded-xl border bg-emerald-50 border-emerald-300 text-emerald-900 text-sm';
                feedbackHeader.innerHTML = `
                    <svg class="w-5 h-5 text-emerald-400 inline mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span class="text-emerald-400 font-bold">Correct! Excellent work.</span>
                `;
            } else {
                feedbackBox.className = isDarkMode 
                    ? 'mt-6 p-5 rounded-xl border bg-rose-950/40 border-rose-500/50 text-rose-200 text-sm'
                    : 'mt-6 p-5 rounded-xl border bg-rose-50 border-rose-300 text-rose-900 text-sm';
                const correctStr = q.type === 'sata' ? q.correct.join(', ') : q.correct;
                feedbackHeader.innerHTML = `
                    <svg class="w-5 h-5 text-rose-400 inline mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    <span class="text-rose-400 font-bold">Incorrect. Correct Answer: <span class="underline">${correctStr}</span></span>
                `;
            }
            feedbackRationale.textContent = q.why;
        }

        function updateLiveGrade() {
            const submittedKeys = Object.keys(submittedAnswers);
            const totalSubmitted = submittedKeys.length;
            if (totalSubmitted === 0) {
                gradeDisplay.textContent = 'Grade: 100% (0/30)';
                return;
            }

            let correctCount = 0;
            submittedKeys.forEach(k => {
                if (submittedAnswers[k].isCorrect) correctCount++;
            });

            // Grade starts at 100% and reflects percentage of correct answers out of total submitted so far
            const currentPercentage = Math.round((correctCount / totalSubmitted) * 100);
            gradeDisplay.textContent = `Grade: ${currentPercentage}% (${correctCount}/${totalSubmitted})`;
        }

        function prevQuestion() {
            if (currentIndex > 0) {
                loadQuestion(currentIndex - 1);
            }
        }

        function nextQuestion() {
            if (currentIndex < filteredQuestions.length - 1) {
                loadQuestion(currentIndex + 1);
            } else {
                finishExam();
            }
        }

        function goToQuestion(index) {
            loadQuestion(index);
        }

        function finishExam() {
            let correctCount = 0;
            Object.keys(submittedAnswers).forEach(k => {
                if (submittedAnswers[k].isCorrect) correctCount++;
            });

            const finalPercentage = Math.round((correctCount / 30) * 100);

            examView.classList.add('hidden');
            sidebarContainer.classList.add('hidden');
            resultsView.classList.remove('hidden');

            document.getElementById('final-percentage').textContent = `${finalPercentage}%`;
            document.getElementById('final-fraction').textContent = `${correctCount} / 30 Correct`;

            const badge = document.getElementById('final-readiness-badge');
            const desc = document.getElementById('final-readiness-desc');

            if (finalPercentage >= 90) {
                badge.className = 'inline-block px-4 py-2 rounded-xl text-sm font-bold mb-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                badge.textContent = '27-30: Complete Mastery!';
                desc.textContent = 'Outstanding result! You have locked down the core microbiological concepts. Review the cram sheet and rest before your exam.';
            } else if (finalPercentage >= 70) {
                badge.className = 'inline-block px-4 py-2 rounded-xl text-sm font-bold mb-3 bg-amber-500/20 text-amber-300 border border-amber-500/30';
                badge.textContent = '21-26: Solid Understanding';
                desc.textContent = 'Good progress! Re-read only the specific study guide Parts for the questions you missed.';
            } else {
                badge.className = 'inline-block px-4 py-2 rounded-xl text-sm font-bold mb-3 bg-rose-500/20 text-rose-300 border border-rose-500/30';
                badge.textContent = 'Review Recommended';
                desc.textContent = 'Read Parts 3, 5, and 6 again thoroughly, focusing on heat parameters, testing methodologies, and chemical agents.';
            }
        }

        function reviewAllAnswers() {
            resultsView.classList.add('hidden');
            examView.classList.remove('hidden');
            sidebarContainer.classList.remove('hidden');
            loadQuestion(0);
        }

        function restartExam() {
            userSelections = {};
            submittedAnswers = {};
            currentIndex = 0;
            resultsView.classList.add('hidden');
            welcomeView.classList.remove('hidden');
            sidebarContainer.classList.add('hidden');
            updateLiveGrade();
        }

        function showAlert(msg) {
            const alertBox = document.createElement('div');
            alertBox.className = 'fixed top-24 right-6 bg-slate-800 text-white border border-slate-700 px-6 py-3.5 rounded-xl shadow-2xl z-50 text-sm font-medium animate-bounce';
            alertBox.textContent = msg;
            document.body.appendChild(alertBox);
            setTimeout(() => alertBox.remove(), 2500);
        }
    </script>
</body>
</html>
